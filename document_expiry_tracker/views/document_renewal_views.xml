<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Search View -->
    <record id="view_document_renewal_search" model="ir.ui.view">
        <field name="name">document.renewal.search</field>
        <field name="model">document.renewal</field>
        <field name="arch" type="xml">
            <search string="Renewal Requests">
                <field name="name"/>
                <field name="document_id"/>
                <field name="responsible_id"/>

                <filter name="my_requests"
                        string="My Requests"
                        domain="[('responsible_id', '=', uid)]"/>

                <group>
                    <filter name="group_by_state"
                            string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_by_responsible"
                            string="Responsible User"
                            context="{'group_by': 'responsible_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- List View -->
    <record id="view_document_renewal_list" model="ir.ui.view">
        <field name="name">document.renewal.list</field>
        <field name="model">document.renewal</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="document_id"/>
                <field name="request_date"/>
                <field name="old_expiry_date"/>
                <field name="new_expiry_date"/>
                <field name="responsible_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_document_renewal_form" model="ir.ui.view">
        <field name="name">document.renewal.form</field>
        <field name="model">document.renewal</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start"
                            type="object"
                            string="Start"
                            invisible="state != 'draft'"/>

                    <button name="action_submit"
                            type="object"
                            string="Submit for Approval"
                            invisible="state != 'in_progress'"/>

                    <button name="action_complete"
                            type="object"
                            string="Complete"
                            invisible="state != 'waiting_approval'"/>

                    <button name="action_cancel"
                            type="object"
                            string="Cancel"
                            invisible="state in ['completed', 'cancelled']"/>

                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,in_progress,waiting_approval,completed"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Renewal Information">
                            <field name="document_id"/>
                            <field name="request_date"/>
                            <field name="responsible_id"/>
                        </group>

                        <group string="Expiry Dates">
                            <field name="old_expiry_date"/>
                            <field name="new_expiry_date"/>
                        </group>
                    </group>

                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_document_renewal" model="ir.actions.act_window">
        <field name="name">Renewal Requests</field>
        <field name="res_model">document.renewal</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id"
               ref="view_document_renewal_search"/>
    </record>

    <!-- Menu -->
    <menuitem id="menu_document_renewals"
              name="Renewal Requests"
              parent="menu_document_root"
              action="action_document_renewal"
              sequence="30"/>

</odoo>