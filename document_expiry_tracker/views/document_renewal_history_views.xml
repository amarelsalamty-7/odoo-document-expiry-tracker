<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_document_renewal_history_list" model="ir.ui.view">
        <field name="name">document.renewal.history.list</field>
        <field name="model">document.renewal.history</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="document_id"/>
                <field name="renewal_id"/>
                <field name="old_expiry_date"/>
                <field name="new_expiry_date"/>
                <field name="renewal_date"/>
                <field name="renewed_by"/>
            </list>
        </field>
    </record>

    <record id="view_document_renewal_history_form" model="ir.ui.view">
        <field name="name">document.renewal.history.form</field>
        <field name="model">document.renewal.history</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group string="Renewal Information">
                            <field name="document_id"/>
                            <field name="renewal_id"/>
                            <field name="renewal_date"/>
                            <field name="renewed_by"/>
                        </group>
                        <group string="Expiry Dates">
                            <field name="old_expiry_date"/>
                            <field name="new_expiry_date"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_document_renewal_history"
            model="ir.actions.act_window">
        <field name="name">Renewal History</field>
        <field name="res_model">document.renewal.history</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_document_renewal_history"
              name="Renewal History"
              parent="menu_document_root"
              action="action_document_renewal_history"
              sequence="40"/>
</odoo>